# Path to the raw Kaggle "Customer Support on Twitter" CSV.
# Download from: https://www.kaggle.com/datasets/thoughtvector/customer-support-on-twitter
DATA_PATH=data/raw/twcs.csv

# Optional: force a specific brand author_id instead of the auto-selected one.
# Leave empty to let scripts/02_select_brand.py choose automatically.
BRAND_HANDLE=

# Optional LLM provider. If left empty, the system runs in LLM-FREE fallback mode
# (retrieval-grounded replies only, no generative drafting).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
